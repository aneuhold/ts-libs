{
  "name": "ts-libs",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r --stream build",
    "watch": "tsx scripts/watchAll.ts",
    "unpub": "pnpm -r --stream unpub:local",
    "lint": "pnpm -r --stream lint",
    "check": "pnpm -r --stream check",
    "test": "pnpm -r --stream test",
    "preparePkg": "tsx scripts/prepareAllPackages.ts",
    "upgrade:core": "pnpm update '@aneuhold/*' --latest && pnpm -r --stream upgrade:core",
    "upgrade:all": "pnpm up && pnpm -r --stream upgrade:all"
  },
  "devDependencies": {
    "@aneuhold/eslint-config": "^3.0.2",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
